{% set attributes_set = create_attributes_set(
  {
    default: {
      wrapper: 'teaser'
    }
  },
  { variant: variant }
) %}
<article{{ attributes_set.wrapper.merge(attributes) }}>
    <{{ headline_size }}>
    Tolle Komponente
  </{{ headline_size }}>
    <div class="teaser__meta">
      {{ meta }}
    </div>
    <div class="teaser__top">
      <div class="teaser__image">
        {{ image }}
      </div>
       {{ title }}
    </div>
  </header>
  <div class="teaser__content">
    {{ content }}
  </div>
</article>

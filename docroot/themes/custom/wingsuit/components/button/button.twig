{#
  Defaults
#}
{% set attributes = attributes|default(create_attribute()) %}
{% set tag_name = tag_name|default('div') %}
{% set size = size|default('medium') %}
{% set disabled = disabled|default(false) %}
{% set icon_alignment = icon_alignment|default('right') %}
{% set active_key = disabled == false ? 'active' : 'disabled' %}
{% set icon = variant == 'icon' ? icon|default('search') : icon %}
{% set url = disabled ? null : url %}
{% set variant = variant|default('default') %}

{#
  Internal logic
#}
{% if url is not empty %}
  {% set attributes = attributes.setAttribute('href', url) %}
  {% set tag_name = 'a' %}
{% endif %}

{#
  Attributes
#}
{% set attributes = attributes.addClass([
  extra_classes
  ])
  .setAttribute('traget', target)
  .setAttribute('title', title)
  .setAttribute('disabled', disabled)
%}
{#
  Template
#}
{% set attributes_set = create_attributes_set(
  {
      default: {
      size: ''
    },
      size: {
      small: 'py-2 px-4 gap-[10PX] text-sm tracking-[0.01em] icon-scale-1',
      medium: 'py-[10px] px-4 gap-[10PX] icon-scale-1 tracking-[0.01em]',
      large: 'py-3 px-4 gap-[10PX] text-lg icon-scale-1.25',
    }
  },
  { variant: variant, size: size }
) %}
<{{ tag_name }} {{ attributes.merge(attributes_set.size) }}>
  {% if variant != 'icon' %}
    {{ text }}
  {% endif %}
{#  {% if icon|render is not empty %}#}
{#    {{ pattern('icon', {icon: icon, scale: icon_scale }, 'spritemap' ) }}#}
{#    {% include "@" %}#}
{#  {% endif %}#}
</{{ tag_name }}>

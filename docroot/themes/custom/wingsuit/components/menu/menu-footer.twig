{#
  Attributes
#}

{% set attributes_set = create_attributes_set(
  {
    default: {
      first_ul: "",
      first_li: "",
      first_a: "font-bold font-display dark:text-white text-lg block font-sans mb-2",
      descendant_ul: "grid gap-1 lg:gap-2",
      descendant_li: "",
      descendant_a: "dark:text-white hover:underline",
  }
  },
  { }
) %}

{% set first_ul_attributes = create_attribute().merge(attributes_set.first_ul) %}
{% set first_li_attributes = create_attribute().merge(attributes_set.first_li) %}
{% set first_a_attributes = create_attribute().merge(attributes_set.first_a) %}
{% set descendant_ul_attributes = create_attribute().merge(attributes_set.descendant_ul) %}
{% set descendant_li_attributes = create_attribute().merge(attributes_set.descendant_li) %}
{% set descendant_a_attributes = create_attribute().merge(attributes_set.descendant_a) %}
{#
  Template
#}

{% set cells = [] %}
{% for item in items %}
  {% set cell %}
    <ul role="menu" {{ first_ul_attributes }}>
      <li role="none" {{ first_li_attributes }}>
        {# -- Main parent item w/o link  -- #}
        <a href="{{ item.url }}" {{ first_a_attributes }}>
          {{ item.title }}
        </a>
        {# -- Child items -- #}
        {% if item.below %}
          <ul role="menu" {{ descendant_ul_attributes }}>
            {% for child in item.below %}
              <li role="none" {{ descendant_li_attributes }}>
                <a href="{{ child.url }}" {{ descendant_a_attributes }}>
                  {{ child.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    </ul>
  {% endset %}
  {% set cells = cells|merge([cell]) %}
{% endfor %}

<nav aria-label="footer" class="w-full">
{#  {{ pattern('grid', {cells:cells, gutter: 'footer'}, 'column_' ~ cells|length ) }}#}
  {% include 'wingsuit:grid' with {
    cells: cells,
    gutter: 'footer',
    variant: 'column_' ~ cells|length
  } only %}
</nav>

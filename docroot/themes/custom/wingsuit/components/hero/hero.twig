{#
/**
 * @file
 * hero
 *
 * See hero.wingsuit.yaml for documentation.
 */
#}
{#
  Internal logic
#}
{% set direction_key = reverse == false ? 'forward' : 'reverse' %}
{% set cell_left %}{{- cell_left -}}{% endset %}
{% set cell_right %}{{- cell_right -}}{% endset %}

{% set attributes_set = create_attributes_set(
  {
    default: {
    cell_left: 'flex flex-col relative',
    cell_right: 'flex flex-1 items-center',
    image: 'relative z-20',
    base: 'absolute transform filter'
  }
  },
  {}
) %}
{#
  Attributes
#}
{% set cell_left_attributes = create_attribute().merge(attributes_set.cell_left) %}
{% set cell_right_attributes = create_attribute().merge(attributes_set.cell_right) %}
{% set image_attributes = create_attribute().merge(attributes_set.image) %}
{#
  TEMPLATE
#}
{{ dump(cell_right) }}
<section>
  {% set cell_left %}
    <div {{ cell_left_attributes}}>
      <div {{ image_attributes }}>
        xxx
         {{ image }}
      </div>
    </div>
  {% endset %}
  {% set cell_right %}
    <div {{ cell_right_attributes}}>
      {% include 'wingsuit:rich-snippet' with {
        preheadline: preheadline,
        headline: headline,
        text: text,
        action: action,
        headline_tag: headline_tag,
        variant: 'large'
      } only %}
    </div>
  {% endset %}
  {% include 'wingsuit:grid' with {
    cells: [cell_left, cell_right],
    reverse: reverse,
    flip_mobile: true,
    vertical_center: true,
    variant: 'column_2',
    preheadline: preheadline,
    headline: headline,
    text: text,
    action: action,
    headline_tag: headline_tag,
    image: image
  } only %}
</section>


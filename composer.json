{
    "name": "wingsuit-designsystem/wingsuit-kickstarter",
    "type": "project",
    "version": "2.0.0",
    "description": "Starterkit for Wingsuit and Layout Builder.",
    "license": "GPL-2.0-or-later",
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "assets": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "require": {
        "mglaman/composer-drupal-lenient": "^1.0",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.6.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "ext-dom": "*",
        "drupal/core-composer-scaffold": "^10.4",
        "drupal/core-recommended": "^10.4",
        "drupal/config_split": "^2",
        "drupal/focal_point": "^2.0@alpha",
        "drupal/media_library_edit": "^3",
        "drupal/gin": "^3",
        "drupal/gin_lb": "^1",
        "drupal/twig_tweak": "^3",
        "drupal/field_group": "^3",
        "drupal/schema_metatag": "^3",
        "drupal/ctools": "^4",
        "drupal/diff": "^1",
        "drupal/layout_builder_restrictions": "^3",
        "drupal/redirect": "^1",
        "drupal/schemata": "^1@beta",
        "drupal/pathauto": "^1",
        "drupal/linkit": "^7",
        "drupal/twig_vardumper": "^3",
        "drupal/media_library_form_element": "^2.1",
        "drupal/section_library": "^1",
        "drupal/ui_patterns": "^2@alpha",
        "bower-asset/dropzone": "5.7.2",
        "drupal/section_library_reusable": "^1@beta",
        "drupal/svg_image_field": "^2",
        "drupal/viewsreference": "^2",
        "drupal/imageapi_optimize_webp": "^2",
        "drupal/media_bulk_upload": "^3",
        "drupal/devel": "^5",
        "drupal/metatag_open_graph": "^1",
        "drupal/formdazzle": "^4",
        "drupal/webform_config_ignore": "^1",
        "drupal/advanced_text_formatter": "^3@RC",
        "drupal/easy_breadcrumb": "^2",
        "drupal/view_modes_display": "^3",
        "drush/drush": "^13",
        "drupal/layout_builder_browser": "^1.0@dev",
        "drupal/wingsuit_companion": "3.0.x-dev",
        "drupal/coder": "^8.3",
        "drupal/devel_entity_updates": "^4.2",
        "drupal/ui_patterns_settings": "3.0.x-dev",
        "drupal/system_stream_wrapper": "^2.0",
        "drupal/webform": "^6.2"
    },

    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "mglaman/composer-drupal-lenient": true,
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "acquia/drupal-recommended-settings": true

        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "patches": {
            "drupal/core": {
                "Callers of LayoutEntityHelperTrait::getEntitySections() do not account for the view mode": "https://www.drupal.org/files/issues/2022-12-15/3008924-42.patch",
                "Not all form elements can't use in vertical_tabs": "https://www.drupal.org/files/issues/2022-03-14/2190333-20.patch",
                "PHP message: Error: Call to a member function getEntityTypeId() on null (Layout Builder)": "https://www.drupal.org/files/issues/2020-08-05/3049332-inline-35.patch",
                "Stream wrapper reference in JS library causes error in _locale_parse_js_file()": "https://www.drupal.org/files/issues/2020-05-08/2735717-28.patch",
                "New non translatable field on translatable content throws error": "https://www.drupal.org/files/issues/2022-09-30/3025039-MR1105-79.patch",
                "Layout builder doesn't support bundle computed field": "https://www.drupal.org/files/issues/2024-07-02/layoutbuilder-bundlecomputedfieldsfix-3034979-21-11.x.patch"
            }
        },
        "composer-exit-on-patch-failure": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "docroot/"
            }
        },
        "enable-patching": true,
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "installer-types": [
            "drupal-profile",
            "drupal-module",
            "drupal-core",
            "drupal-library",
            "bower-asset",
            "npm-asset"
        ],
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/media_responsive_thumbnail",
                "drupal/simple_gmap",
                "drupal/ui_patterns_extends",
                "drupal/layout_builder_st",
                "drupal/section_library_reusable",
                "drupal/entity_block",
                "drupal/imageapi_optimize_webp",
                "drupal/media_bulk_upload",
                "drupal/layout_builder_save_and_edit",
                "drupal/metatag_open_graph",
                "drupal/webform_config_ignore",
                "drupal/colorwidget",
                "drupal/view_modes_display",
                "drupal/bg_image_formatter",
                "drupal/toolbar_anti_flicker"
            ]
        }
    }
}
